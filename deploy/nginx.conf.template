# Plain-HTTP bootstrap vhosts. Install with scripts/install-nginx.sh, which substitutes the
# domains and ports, then run certbot --nginx to add TLS (certbot rewrites these files).
server {
    listen 80;
    listen [::]:80;
    server_name ${AUTH_DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:${AUTH_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${RELAY_DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:${RELAY_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Relay sessions are long-lived websockets.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
